// V1 marketplace — buyer-side discovery
// ─────────────────────────────────────────────────────────────────────────────

/// Heart-icon favorite. Lightweight signal — used to show "saved" tab and to
/// boost rank in the discover feed. Not a follow (that has notification opt-ins).
model ShopFavorite {
  userId    String
  shopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([userId, createdAt])
  @@index([shopId, createdAt])
}

/// Subscribing to a shop. Generates push notifications on opt-in events
/// (new product, going live, flash sale). Stronger signal than a favorite.
model ShopFollow {
  userId     String
  shopId     String
  notifyNew  Boolean @default(true)  // new product
  notifyLive Boolean @default(true)  // V2 live shopping
  notifySale Boolean @default(true)  // flash sale / coupon drops
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([userId, createdAt])
  @@index([shopId, createdAt])
}

/// Implicit signal for "For You" feed ranking. Anonymous-friendly: userId is
/// nullable so we can also track LIFF/web sessions cookie-based later. Rows
/// are aggressively expired (older than 30 days) by a cron job — keep small.
model ProductView {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([userId, viewedAt])
  @@index([productId, viewedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Group Buy / Pre-order — V2.0 Social Commerce
// ─────────────────────────────────────────────────────────────────────────────

/// A `GroupBuy` campaign tied to a single Product. Buyers join by placing an
/// order during the campaign window; once the cumulative `currentQty` hits
/// `minQty` before `deadline`, the group fills and member orders become
/// confirmable. Falls back to refund if it doesn't fill in time.
///
/// Tier pricing is shop-friendly: the price the buyer pays depends on the
/// total group size at fill time. Modeled as a Json array of
/// `{ minQty, priceSatang }` — tier with the largest `minQty` <= currentQty
/// wins. Empty `tiers` means single-price (use `Product.priceSatang`).
///
/// Statuses:
///   ACTIVE      Campaign open, accepting orders.
///   FILLED      Reached `minQty` before deadline. Member orders unlock.
///   EXPIRED     Deadline passed without filling. Member orders auto-cancel + refund.
///   CANCELLED   Shop owner pulled the plug. Member orders auto-refund.
model GroupBuy {
  id        String         @id @default(cuid())
  shopId    String
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  title       String // Headline shown on the buy button + share card.
  description String? // Optional rich description.
  minQty      Int // Threshold to flip the group from ACTIVE → FILLED.
  maxQty      Int? // Optional cap; nullable = unlimited.
  /// Quantity already committed by joined orders. Bumped atomically on join,
  /// decremented on member-order cancel. We snapshot this on FILLED so late
  /// cancels don't accidentally reopen the group.
  currentQty  Int @default(0)

  /// Tier pricing. Json array of `{ minQty, priceSatang }`. Empty → use
  /// Product.priceSatang flat. Tiers are validated server-side at create
  /// time (monotonically increasing minQty, decreasing price).
  tiers Json @default("[]")

  deadline  DateTime
  filledAt  DateTime?
  expiredAt DateTime?

  status   GroupBuyStatus    @default(ACTIVE)
  members  GroupBuyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, deadline])
  @@index([status, deadline])
  @@index([productId, status])
}

enum GroupBuyStatus {
  ACTIVE
  FILLED
  EXPIRED
  CANCELLED
}

/// Junction row connecting an Order to a GroupBuy. One member row per
/// participating order. We keep `qty` denormalized so the auto-fill cron
/// can compute currentQty by SUM without joining Order (cheaper at scale).
///
/// On member-order CANCELLED before fill: row is deleted + `GroupBuy.currentQty`
/// is decremented. After fill: row is kept for audit but currentQty is frozen.
model GroupBuyMember {
  id         String   @id @default(cuid())
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  qty           Int // Snapshot of this order's contribution to currentQty.
  priceLockedSatang Int // Price this buyer locked in at join time.

  createdAt DateTime @default(now())

  @@index([groupBuyId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Protected Pay (Escrow) — V1.5 Trust Layer
// ─────────────────────────────────────────────────────────────────────────────

/// Per-order escrow record. Lifecycle:
///   HELD     — funds captured at PAID (slip-verify). Money sits with platform.
///   RELEASED — funds released to shop. Reason: buyer-confirm OR auto-release
///              cron (DELIVERED + 72h) OR admin manual OR dispute RESOLVED_NO_ACTION.
///   REFUNDED — money returned to buyer. Reason: dispute RESOLVED_REFUND OR admin manual.
///   DISPUTED — temporarily frozen while a dispute is being investigated.
///
/// `providerRef` is the external escrow provider's reference (2C2P / Beam /
/// KBank Open API) once we wire one. Until then the stub provider just
/// generates a synthetic ref so the audit log has something to point at.
model EscrowHold {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amountSatang Int // Total being held (subtotal + shipping; does NOT include fee)
  feeSatang    Int // Buyer-paid escrow fee (1.5% of subtotal+shipping, rounded up)

  status         EscrowStatus @default(HELD)
  // Calculated at HELD time = DELIVERED time + 72h. Cron uses this to find
  // releaseable rows. If null, cron skips (waiting for DELIVERED transition
  // to set it via a separate update).
  scheduledReleaseAt DateTime?

  heldAt      DateTime  @default(now())
  releasedAt  DateTime?
  refundedAt  DateTime?
  // Free-text audit hint: "buyer_confirmed" | "auto_release_72h" | "admin_manual"
  // | "dispute_no_action" | "dispute_refund" | "admin_refund". Helps trace
  // which actor closed the hold during incident review.
  closeReason String?

  // Provider reference (stub returns "stub-<id>" today).
  providerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledReleaseAt])
  @@index([status, heldAt])
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform admin — audit trail (existing)
// ─────────────────────────────────────────────────────────────────────────────

/// Every mutating admin action gets a row here. Append-only — no UI to edit.
/// Surfaced at /admin/audit, used for incident review + accountability.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String // e.g. "user.suspend", "shop.feature", "settings.update"
  targetType String? // "user" | "shop" | "subscription" | "review" | "setting" | ...
  targetId   String?
  diff       Json? // before/after snapshot or arbitrary action context
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Mobile auth bridge — V2.1 native sign-in handoff
// ─────────────────────────────────────────────────────────────────────────────

/// Short-lived (5 min) handoff slot used by the mobile app to receive a
/// SalePage JWT after the user completes Auth.js's normal Google sign-in on
/// the web. Flow:
///   1. Mobile app POSTs /api/v1/auth/mobile-bridge/start → row created
///   2. Mobile opens /api/v1/auth/mobile-bridge/google?bridge=ID in the
///      system browser; that route sets a signed cookie + redirects into the
///      same Google OAuth flow the web uses. On completion the /complete
///      route writes a freshly-minted JWT into `token` here.
///   3. Mobile polls /api/v1/auth/mobile-bridge/poll?bridge=ID until `token`
///      is filled, then stores it and closes the browser.
///
/// This sidesteps the SDK 54 `useProxy` removal: the user signs into the same
/// Web OAuth client (`AUTH_GOOGLE_ID`) the web uses, so the user lands on the
/// exact same `User` row keyed by lower-cased email.
model MobileAuthBridge {
  id        String   @id @default(cuid())
  provider  String // "google" | "line" (future) — distinguishes bridge purpose
  token     String? // Filled by /complete with the SalePage mobile JWT. Single-read.
  userId    String? // User id once known. Cascade-deletes if the user is deleted.
  user      User?    @relation("MobileAuthBridgeUser", fields: [userId], references: [id], onDelete: Cascade)
  // 5 minutes from createdAt. Rows past this are deleted by the same daily
  // cron that prunes other auth ephemerals.
  expiresAt DateTime
  // Set when /poll returns the token to mobile — prevents replay.
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Email-OTP login — V2.1 inline mobile auth
// ─────────────────────────────────────────────────────────────────────────────

/// Short-lived (10 min) 6-digit code emailed to a user when they tap
/// "Continue with email" in the mobile app. The OTP screen verifies the
/// code, finds-or-creates the User by email, and mints a SalePage mobile
/// JWT. No bouncing to the web — the whole flow runs inside the app
/// (911korn 2026-05-26: "ทำงานจบได้ในแอพไม่ต้องเด้งไปที่อื่น").
///
/// Rate-limited by checking how many active rows exist for the same email
/// (1-minute resend cooldown) and how many wrong attempts have been made
/// against this row (5 max).
model EmailLoginOtp {
  id           String   @id @default(cuid())
  email        String // lower-cased
  // bcrypt-hashed 6-digit code. Plaintext is emailed once + never stored.
  codeHash     String
  // Number of /verify attempts so far. Locks at 5.
  attempts     Int      @default(0)
  // Set on successful verify so a stolen row can't be replayed.
  consumedAt   DateTime?
  // 10 minutes from createdAt.
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  // userId is null until first /verify match (or if email belongs to no
  // existing User — we still mint a User row then).
  userId       String?
  user         User?    @relation("EmailLoginOtpUser", fields: [userId], references: [id], onDelete: Cascade)
  // Optional IP / UA captured at /send for fraud audit. Not used by the
  // verify flow — purely forensic.
  requestIp    String?
  requestUa    String?

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

// V2.2 — UGC moderation (Apple Guideline 1.2). Buyers + sellers can
// report any user-generated content (shop, product, review, story,
// live comment) and block other users they don't want to see.
//
// Apple expects:
//   - In-app report → reaches an operator within 24h
//   - In-app block → immediately hides the blocked party from the
//     reporter's feeds + comments
//   - Terms of Service that explicitly forbid objectionable content
//
// We satisfy the 24h commitment via an admin queue at /admin/reports
// that pages super-admins on new entries.
model ContentReport {
  id          String           @id @default(cuid())
  reporterId  String
  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // Target — exactly one of these is set per the kind.
  kind        ContentReportKind
  // For SHOP / PRODUCT this is the shop slug + optional product slug.
  shopId      String?
  productId   String?
  reviewId    String?
  storyId     String?
  liveCommentId String?
  // Operator-canonical reason code so the admin queue can be filtered.
  reason      ContentReportReason
  // Free-text detail from the reporter. Limited to 1000 chars client-side.
  note        String?         @db.Text
  status      ContentReportStatus @default(OPEN)
  // Set when an admin acts on the report.
  resolvedAt  DateTime?
  resolvedBy  String?
  resolutionNote String?      @db.Text
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([kind, status])
}

enum ContentReportKind {
  SHOP
  PRODUCT
  REVIEW
  STORY
  LIVE_COMMENT
}

enum ContentReportReason {
  SPAM
  INAPPROPRIATE
  COUNTERFEIT
  HARASSMENT
  ILLEGAL
  MISLEADING
  OTHER
}

enum ContentReportStatus {
  OPEN
  REVIEWING
  RESOLVED_REMOVED
  RESOLVED_KEPT
  DUPLICATE
}

// User-to-shop block. Once present, the blocked shop disappears from
// the reporter's discovery feed + search results, and the reporter's
// comments/reviews on that shop are hidden from the shop owner.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockeeId String
  blockee   User     @relation("Blockee", fields: [blockeeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockeeId])
  @@index([blockerId])
}

// V2.3 — Bring-your-own payment gateway, Business+ only.
//
// Sellers on Business+ plug in their Omise / Stripe / 2C2P / GBPrimePay
// / PayPal etc. API keys. We store the keys encrypted at rest (AES-256-GCM
// with PAYMENT_GATEWAY_ENCRYPTION_KEY) and use them server-side when the
// shop's buyers checkout via the gateway-backed flow. PromptPay stays
// the default for every shop — gateways are an add-on for shops that
// want credit-card support or alt-pay-methods their bank-direct QR
// doesn't cover.
//
// One row = one (shopId, provider) — a shop can only have one Omise
// config at a time, but can have multiple providers active in parallel.
model ShopPaymentGateway {
  id                 String                    @id @default(cuid())
  shopId             String
  shop               Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider           PaymentGatewayProvider
  // Public-side identifiers (e.g. Omise public key, Stripe publishable
  // key, 2C2P merchant ID) — these are technically not secret but we
  // store them alongside so the dashboard UI can mask + display them
  // consistently.
  publicKey          String
  // AES-256-GCM ciphertext of the secret API key. Format produced by
  // src/lib/payment-gateways/crypto.ts → "v1:<iv-hex>:<tag-hex>:<ciphertext-hex>".
  secretKeyEncrypted String                    @db.Text
  // For gateways that need a webhook signing secret (Stripe, Omise) — also
  // encrypted. Optional because not every provider requires one.
  webhookSecretEncrypted String?               @db.Text
  // "test" → seller's testing/sandbox keys · "live" → production keys.
  // Both can be stored simultaneously? No — one row is one mode. Seller
  // toggles between in dashboard.
  mode               PaymentGatewayMode        @default(TEST)
  // When false, server treats this row as "saved but disabled" — won't
  // surface to buyers, won't accept webhooks. Seller can flip on after
  // testing.
  enabled            Boolean                   @default(false)
  // Last time we called the provider's "validate keys" endpoint. Lets
  // the UI badge keys as "verified at <ts>" or "needs re-test".
  lastTestedAt       DateTime?
  lastTestStatus     PaymentGatewayTestStatus?
  // Free-text from the last test — provider error message if FAILED,
  // account display name if OK.
  lastTestMessage    String?                   @db.Text
  // Optional display label so a shop with multiple Omise accounts (rare)
  // can tell them apart.
  label              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([shopId, provider])
  @@index([shopId])
  @@index([provider])
}

enum PaymentGatewayProvider {
  OMISE        // opn.co (formerly Omise) — most popular Thai SME PSP
  STRIPE       // global, supports THB since 2023
  KSHER        // cross-border CN↔TH, popular with shops selling to Chinese
  C2P          // 2C2P — Asian payments hub, popular Thai ecom
  GBPRIMEPAY   // GBPrimePay — Bangkok Bank backed
  PAYSOLUTIONS // PaySolutions — Thai local
  KBANK        // K-Payment Gateway (Kasikornbank)
  SCB          // SCB Easy Pay / SCB Connect
  KRUNGSRI     // Krungsri Bay Online / KrungsriPay
  TRUEMONEY    // TrueMoney Wallet
  RABBIT_LINEPAY // Rabbit LINE Pay
  PAYPAL       // global cross-border
}

enum PaymentGatewayMode {
  TEST
  LIVE
}

enum PaymentGatewayTestStatus {
  OK
  FAILED
  PENDING
}

// V2.3 — Custom domain mapping per shop. Business+ feature.
//
// Workflow: seller types a domain they own (or just bought) into the
// dashboard. We register it on our Vercel project via Vercel API.
// Vercel returns the nameservers they need to set at their registrar
// (ns1.vercel-dns.com / ns2.vercel-dns.com). Seller pastes those into
// their registrar. Once DNS propagates Vercel auto-issues SSL and
// auto-routes — middleware reads the Host header at request time and
// rewrites the URL to /s/<slug>/... so the shop renders under the
// custom domain.
//
// 911korn 2026-05-28 "ลูกค้าไปสมัคร Domain ที่อื่นได้เลย เราแค่ออก NS1
// NS2 มาให้เอาไปใส่ จบ".
model ShopDomain {
  id        String              @id @default(cuid())
  shopId    String
  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Lower-cased domain — e.g. "siamsnack.com" (apex) or "shop.siamsnack.com".
  // Apex domains imply we also serve www → the middleware redirects
  // www.siamsnack.com → siamsnack.com when this row's domain is the apex.
  domain    String              @unique
  // The two nameservers we tell the seller to paste at their registrar.
  // Populated when we created the CF zone for them. Each new zone gets
  // a different (deterministic) pair from CF's pool — e.g. romina + yoxall.
  ns1       String?
  ns2       String?
  status    ShopDomainStatus    @default(PENDING_DNS)
  // Last reason if status == FAILED.
  failedReason String?          @db.Text
  // CF zone id so we can manage records + delete via API later.
  cfZoneId  String?
  verifiedAt DateTime?
  // Stamp of the last verify-poll so we don't spam the Vercel API.
  lastCheckedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([shopId])
  @@index([status, lastCheckedAt])
}

enum ShopDomainStatus {
  PENDING_DNS  // waiting for seller to set NS at registrar
  VERIFYING    // DNS detected, Vercel issuing cert
  VERIFIED     // live + serving
  FAILED       // verification failed — see failedReason
}
