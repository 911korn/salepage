// SalePage — Prisma schema
// Postgres (Neon shared Singapore cluster, db=salepage)
//
// Conventions:
// - Monetary fields are stored in **satang** (Int) — 1 THB = 100 satang
// - `slug` fields are kebab-case, URL-safe
// - timestamps are UTC, `updatedAt` auto-managed
// - Auth tables follow @auth/prisma-adapter (Auth.js / NextAuth v5)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Stripe (one customer per User across all their shops)
  stripeCustomerId String? @unique

  accounts     Account[]
  sessions     Session[]
  shops        Shop[]
  subscription Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commerce
// ─────────────────────────────────────────────────────────────────────────────

model Shop {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logoText    String? @db.VarChar(4) // single character/emoji shown in the round badge
  bannerUrls  String[] @default([])
  category    String? // matches messages/*.json categories.* keys

  themeColor  String  @default("#e11d48")
  verified    Boolean @default(false)
  status      ShopStatus @default(ACTIVE)

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // PromptPay receiver — drives /api/v1/promptpay/qr generation per shop
  promptpayId String?

  // Policies + contact stored as JSON for flexibility before they crystallize
  policies Json? // { returnPolicy: string, shippingTime: string }
  contact  Json? // { phone?: string, line?: string, facebook?: string }

  // Storefront announcement banner (markdown-lite single line).
  announcement String? @db.Text

  // Loyalty config — null/0 disables. baht spent per 1 point, baht per point on redeem.
  loyaltyBahtPerPoint     Int @default(100)
  loyaltyBahtValuePerPoint Int @default(1)

  rating     Float @default(0)
  totalSold  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  orders    Order[]
  reviews   Review[]
  coupons   Coupon[]
  loyalty   CustomerLoyalty[]

  @@index([ownerId])
}

enum ShopStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Product {
  id          String  @id @default(cuid())
  slug        String
  name        String
  description String?

  // Money in satang
  priceSatang     Int
  compareAtSatang Int?

  imageUrls   String[] @default([])
  badge       ProductBadge?
  type        ProductType   @default(PHYSICAL)
  stock       Int?
  sold        Int           @default(0)
  status      ProductStatus @default(ACTIVE)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId, status])
}

enum ProductBadge {
  HOT
  NEW
  SALE
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders + slip verification
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id          String  @id @default(cuid())
  // Public token the customer uses to track this order without logging in.
  publicToken String  @unique

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Customer (denormalized; no FK — anonymous checkout supported)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?

  // Snapshot of products at time of purchase
  // [{ productId, productSlug, name, qty, priceSatang, image? }]
  items    Json

  subtotalSatang Int
  shippingSatang Int @default(0)
  totalSatang    Int

  status         OrderStatus @default(PENDING)
  paymentMethod  String?     // "promptpay" | "cod" | "stripe"

  // Slip verification trail
  slipImageUrl    String?
  slipRef         String?    // bank transaction ref
  slipVerifiedAt  DateTime?
  slipProvider    String?    // "slipok" | "easyslip" | "mock"
  slipRaw         Json?      // raw response for audit/replay

  trackingNumber String?
  notes          String?

  // Discounts applied at checkout
  couponId             String?
  coupon               Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscountSatang Int     @default(0)
  pointsRedeemed       Int     @default(0)
  pointsEarned         Int     @default(0)

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, createdAt])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Stripe subscriptions (platform billing — not shop payments)
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String   @unique
  stripeCustomerId     String

  plan                 PlanKey
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
}

enum PlanKey {
  FREE
  STARTER
  PRO
  BUSINESS
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

// ─────────────────────────────────────────────────────────────────────────────
// Webhook event log (so failed handlers can be replayed)
// ─────────────────────────────────────────────────────────────────────────────

model StripeEvent {
  id          String   @id // Stripe event.id, e.g. evt_*
  type        String
  livemode    Boolean
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?
  payload     Json

  @@index([type, receivedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews, coupons, loyalty
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  rating        Int      // 1..5
  comment       String?  @db.Text
  customerName  String
  customerPhone String?

  // Owner reply
  reply       String?  @db.Text
  repliedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([productId])
}

model Coupon {
  id             String     @id @default(cuid())
  shopId         String
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code           String     // stored lower-cased; case-insensitive lookup
  type           CouponType
  percent        Int?       // 1..100 (for PERCENT)
  amountSatang   Int?       // for FIXED
  minOrderSatang Int?
  maxRedemptions Int?       // null = unlimited
  redeemedCount  Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]

  @@unique([shopId, code])
  @@index([shopId, active])
}

enum CouponType {
  PERCENT
  FIXED
}

// Per-shop loyalty wallet, identified by phone (anonymous-friendly).
model CustomerLoyalty {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerPhone    String
  customerName     String?
  points           Int      @default(0)
  totalSpentSatang Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shopId, customerPhone])
  @@index([shopId, points])
}
