// SalePage — Prisma schema
// Postgres (Neon shared Singapore cluster, db=salepage)
//
// Conventions:
// - Monetary fields are stored in **satang** (Int) — 1 THB = 100 satang
// - `slug` fields are kebab-case, URL-safe
// - timestamps are UTC, `updatedAt` auto-managed
// - Auth tables follow @auth/prisma-adapter (Auth.js / NextAuth v5)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Platform admin role. USER = regular shop owner. ADMIN = SalePage operator
  // with access to /admin. SUPER_ADMIN can grant/revoke other users' roles
  // and edit PlatformSetting. Defaults to USER for all signups.
  role UserRole @default(USER)

  // Stripe (one customer per User across all their shops)
  stripeCustomerId String? @unique

  // Soft-suspend flag set by /admin/users. Blocks sign-in via NextAuth
  // signIn callback; does not delete data.
  suspended Boolean @default(false)

  // User-initiated soft delete (Apple Guideline 5.1.1(v) — mandatory
  // in-app account deletion since June 2022). Set when the buyer taps
  // "ลบบัญชี" in /me. We blank out PII (email, name, image, lineUserId,
  // expoPushToken) atomically with this flag flip; the record itself is
  // kept so foreign keys on orders/reviews/shops survive. A nightly cron
  // hard-deletes rows where deletedAt is older than 30 days.
  deletedAt DateTime?

  // Expo push notification token (set by mobile app on launch).
  // Cleared on logout via DELETE /api/v1/me/push-token. Single device for now;
  // multi-device support lands when we add a separate UserDevice model.
  expoPushToken String?

  // LINE user id captured during LIFF-based LINE login (V2.1+). When set,
  // we can send order updates + reminders via LINE Messaging API to the
  // user's @salepage chat. Populated by /api/v1/auth/mobile-bridge/line-liff
  // after liff.getProfile() succeeds; null for users who only signed in
  // via Google or email.
  lineUserId    String? @unique

  accounts     Account[]
  sessions     Session[]
  shops        Shop[]
  subscription Subscription?
  adminActions AdminAuditLog[] @relation("AdminActor")

  // V1 marketplace — buyer-side surfaces.
  shopFavorites ShopFavorite[]
  shopFollows   ShopFollow[]
  productViews  ProductView[]

  // V1.5 affiliate — payouts requested by this user (when they earned
  // commissions referring others).
  affiliatePayouts AffiliatePayout[]

  // V2.1 mobile bridge — rows minted while signing this user in on a phone.
  mobileAuthBridges MobileAuthBridge[] @relation("MobileAuthBridgeUser")

  // V2.1 email-OTP login — code requests issued for this user's email.
  emailOtps EmailLoginOtp[] @relation("EmailLoginOtpUser")

  // V2.2 UGC moderation (Apple Guideline 1.2). Reports authored by
  // this user against shops/products/reviews/stories/live-comments.
  reportsFiled ContentReport[] @relation("ReportReporter")
  // Shops the buyer has blocked — hidden from their feeds + search.
  blocks       UserBlock[]    @relation("Blocker")
  blockedBy    UserBlock[]    @relation("Blockee")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commerce
// ─────────────────────────────────────────────────────────────────────────────

model Shop {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoText    String?  @db.VarChar(4) // single character/emoji shown in the round badge
  logoUrl     String?
  bannerUrls  String[] @default([])
  category    String? // matches messages/*.json categories.* keys

  themeColor String     @default("#e11d48")
  /// @deprecated kept for backward compatibility — derive from kycStatus instead.
  /// We keep both during migration so existing UI code that reads `verified`
  /// keeps working until we sweep callsites.
  verified   Boolean    @default(false)
  status     ShopStatus @default(ACTIVE)

  // ── Trust & Verification (V1.5) ──────────────────────────────────────
  // KYC pipeline: NONE → PENDING (docs uploaded) → VERIFIED | REJECTED.
  // EXPIRED used when verification is renewed annually and lapses.
  kycStatus         KycStatus @default(NONE)
  kycVerifiedAt     DateTime?
  kycRejectedReason String?

  // KYC submission payload — set when shop owner submits documents.
  // Cleared on REJECTED (so they can resubmit fresh) but kept on VERIFIED for
  // audit. We store doc URLs as Vercel Blob URLs (signed/public).
  kycDocType        KycDocType?
  kycLegalName      String?
  /// Last 4 digits only — full ID never persisted in plaintext.
  kycIdLast4        String?
  kycDocFrontUrl    String?
  kycDocBackUrl     String?
  kycSelfieUrl      String?
  kycSubmittedAt    DateTime?
  kycReviewedAt     DateTime?
  kycReviewedById   String? // User.id of admin who approved/rejected

  // Computed 0–100 score; refreshed by recomputeTrustScore() on key events
  // (review post, order delivery, KYC change). UI buckets it into tiers.
  trustScore       Int       @default(50)
  trustComputedAt  DateTime?

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // PromptPay receiver — drives /api/v1/promptpay/qr generation per shop
  promptpayId String?

  // Policies + contact stored as JSON for flexibility before they crystallize
  policies Json? // { returnPolicy: string, shippingTime: string }
  contact  Json? // { phone?: string, line?: string, facebook?: string }

  // V2.1 Drop-off shipping — default ที่อยู่ผู้ส่ง printed on every
  // shipping label this shop generates. Stored as proper columns
  // (NOT inside `contact` JSON) so we can index + validate postcode
  // for cart-time shipping zone calculations later. Filled in
  // create-shop wizard + editable from /dashboard/settings. 911korn
  // 2026-05-27 "ต้องให้ร้านระบุที่อยู่ผู้ส่งไว้เป็นค่าเริ่มต้นของร้าน".
  pickupAddress  String? @db.Text
  pickupPostcode String?

  // Storefront announcement banner (markdown-lite single line).
  announcement String? @db.Text

  // Loyalty config — null/0 disables. baht spent per 1 point, baht per point on redeem.
  loyaltyBahtPerPoint      Int @default(100)
  loyaltyBahtValuePerPoint Int @default(1)

  // LINE Messaging API integration (Business+ tier only — gated in code).
  // When all three credential fields are set AND lineWebhookEnabled=true, the
  // /api/v1/line/webhook/:shopId endpoint routes inbound LINE messages into
  // Conversation/ConversationMessage and the dashboard /chat inbox is live.
  lineChannelId          String?
  lineChannelSecret      String?
  lineChannelAccessToken String? @db.Text
  lineWebhookEnabled     Boolean @default(false)

  rating    Float @default(0)
  totalSold Int   @default(0)

  // V1 marketplace — buyer-side reverse relations.
  favoritedBy ShopFavorite[]
  followedBy  ShopFollow[]

  // Admin-only flags. Distinct from owner-controlled `status` (PAUSED/ARCHIVED).
  // `suspended` = platform admin took shop offline (returns 503 on storefront).
  // `featured`  = pinned on landing/discover surfaces by admin.
  suspended Boolean @default(false)
  featured  Boolean @default(false)

  // AI slip-verify credit wallet. Admin can top up via /admin/shops/[id].
  // Decremented per /api/v1/slip/verify call once the plan's monthly quota
  // is exhausted. Defaults to 0 so paid tiers fall back gracefully.
  slipCredits Int @default(0)

  // V1.5 affiliate rate override. NULL means use the platform default (2%).
  // Shops that want to drive virality can opt into a higher rate (max 10%).
  // Stored as integer percent (e.g. 5 = 5%) to avoid float drift.
  affiliateRatePct Int? @db.SmallInt

  // V1.5 Protected Pay opt-in. When TRUE, buyers see a "Protected Pay" toggle
  // at checkout (adds 1.5% fee, funds held in escrow until DELIVERED + 72h
  // or buyer-confirm). When FALSE, all orders are Direct Pay (0% fee, funds
  // settle immediately on slip-verify). Defaults to TRUE because trust is a
  // major friction for new buyers — sellers can opt out via shop settings.
  acceptsEscrow Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  orders            Order[]
  shipments         Shipment[]
  reviews           Review[]
  coupons           Coupon[]
  loyalty           CustomerLoyalty[]
  customerAddresses CustomerAddress[]
  conversations     Conversation[]
  stories           ShopStory[]
  liveBroadcasts    LiveBroadcast[]
  groupBuys         GroupBuy[]
  paymentGateways   ShopPaymentGateway[]
  domains           ShopDomain[]

  @@index([ownerId])
  @@index([featured, status])
  @@index([kycStatus, status])
  @@index([trustScore])
}

enum ShopStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum KycDocType {
  NID // Thai national ID card
  PASSPORT
  COMPANY_REG // ทะเบียนพาณิชย์ / หนังสือรับรองบริษัท
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Product {
  id          String  @id @default(cuid())
  slug        String
  name        String
  description String?

  // Money in satang
  priceSatang     Int
  compareAtSatang Int?

  imageUrls String[]      @default([])
  badge     ProductBadge?
  type      ProductType   @default(PHYSICAL)
  // Optional per-product category override. Falls back to `shop.category`
  // on listing surfaces. Allows a single shop to span multiple categories
  // (e.g. a general store selling "food" + "beauty") without forcing the
  // owner to spin up a second shop.
  category  String?
  // V2.1 condition flag — NEW vs PRE_OWNED. PRE_OWNED renders a prominent
  // "มือสอง" badge on cards and the product detail page.
  condition ProductCondition @default(NEW)
  // V2.1 digital-fulfillment template — only meaningful when type=DIGITAL.
  // Seller pre-fills the content the buyer will receive (game ID:PW, license
  // key, download link, service instructions, etc). On the slip-verified
  // PAID transition we snapshot this onto `Order.digitalFulfillment` so a
  // later product edit doesn't change what a past buyer was sold.
  digitalContent String? @db.Text
  // V2.1 per-product shipping fee in satang. Default 0 = free shipping.
  // Buyer pays this at checkout (per-shop max() across line items), money
  // flows directly to the seller via PromptPay. Seller bears the actual
  // courier cost — they drop off at any Flash/Kerry/J&T/Thai Post counter,
  // pay cash, scan the receipt back into SalePage (Claude vision OCR auto-
  // fills the tracking). Digital products always ship for 0. 911korn
  // 2026-05-27 "ตอนแอด product มีช่องให้ระบุค่าส่งไปเลย".
  shippingFeeSatang Int @default(0)
  stock     Int?
  sold      Int           @default(0)
  status    ProductStatus @default(ACTIVE)
  // V2.1 sold-out timestamp. Set the moment stock decrements to 0 on a
  // PAID order. The discovery feed shows the product for 4h afterwards
  // (with a SOLD OUT overlay so buyers see fresh activity), then auto-
  // hides it. Clearing this column on stock top-up flips the listing
  // back to ACTIVE + visible (911korn 2026-05-27 "ขึ้น 4 ชั่วโมง item
  // นี้จะถูกถอกจาก Feed อัติโนมัติ").
  soldOutAt DateTime?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  reviews   Review[]
  views     ProductView[]
  groupBuys GroupBuy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId, status])
}

enum ProductBadge {
  HOT
  NEW
  SALE
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

/**
 * Product condition. V2.1 — added "PRE_OWNED" so sellers can list
 * second-hand items and we surface a distinct badge on the buyer-side
 * (911korn 2026-05-27: "tag สินค้ามือสอง อันนี้น่าจะมีประโยชน์มาก ทำให้
 * แอพดูมีจุดเด่นขึ้นมาเลย"). NEW is the default; existing rows backfill
 * via the migration default.
 */
enum ProductCondition {
  NEW
  PRE_OWNED
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders + slip verification
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  // Public token the customer uses to track this order without logging in.
  publicToken String @unique

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Customer (denormalized; no FK — anonymous checkout supported)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  // Platform-level LINE identity from the central @salepage LIFF/OA.
  // Orders remain shop-scoped; customer order lookups always filter by shopId
  // when a shop context is present.
  customerLineUserId     String?
  customerLineDisplayName String?
  customerLinePictureUrl  String?
  lineLinkedAt            DateTime?

  // Snapshot of products at time of purchase
  // [{ productId, productSlug, name, qty, priceSatang, image? }]
  items Json

  subtotalSatang Int
  shippingSatang Int @default(0)
  totalSatang    Int

  status        OrderStatus @default(PENDING)
  paymentMethod String? // "promptpay" | "cod" | "stripe"

  // Slip verification trail
  slipImageUrl   String?
  slipRef        String? // bank transaction ref
  slipVerifiedAt DateTime?
  slipProvider   String? // "slipok" | "easyslip" | "mock"
  slipRaw        Json? // raw response for audit/replay

  trackingNumber String?
  shipment       Shipment?
  notes          String?

  // Discounts applied at checkout
  couponId             String?
  coupon               Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscountSatang Int     @default(0)
  pointsRedeemed       Int     @default(0)
  pointsEarned         Int     @default(0)

  // V1.5 affiliate attribution. `referrerUserId` is the salepage user who
  // shared the link (`?ref=<userId>`). `referrerCode` is a freeform short
  // code for ad-campaign tracking (e.g. "yt-thaifood-may26"). Both nullable;
  // we never block checkout on a bad ref.
  referrerUserId String?
  referrerCode   String?

  // V1.5 Protected Pay. When TRUE, an EscrowHold row is created on PAID
  // transition (`slipVerifiedAt` first set), funds are released to the shop
  // only on buyer-confirm or 72h after DELIVERED. `escrowFeeSatang` is the
  // 1.5% buyer-paid fee baked into `totalSatang`.
  useEscrow       Boolean    @default(false)
  escrowFeeSatang Int        @default(0)
  // Buyer's explicit "I got it, release funds" timestamp. Cleared by admin
  // refunds. Used to gate the confirm endpoint (no double-release).
  buyerConfirmedAt DateTime?
  escrow          EscrowHold?

  reviews         Review[]
  disputes        Dispute[]
  groupBuyMember  GroupBuyMember?

  // Cancel metadata (V1.6). Stamped when status flips to CANCELLED:
  //   - cancelledAt: when the cancel happened (drives the 24h restore
  //     window for buyer-initiated cancels)
  //   - cancelledBy: who pressed the cancel — buyer, seller, or system
  //     (cron auto-expire, dispute auto-resolve, group-buy expiry). Only
  //     BUYER cancels are eligible for restore.
  //   - cancelReason: freeform/enum-like string captured from the buyer
  //     in the confirm sheet (e.g. "wrong-address", "changed-mind").
  //     Seller/system cancels leave this null.
  cancelledAt   DateTime?
  cancelledBy   OrderCancelledBy?
  cancelReason  String?

  // V2.1 digital fulfillment — snapshot of `product.digitalContent` taken
  // at the moment slip-verify flipped the order to PAID. Null for
  // physical orders. Buyer reads this from the order tracking page +
  // gets it embedded in the order-paid email. Editing the source product
  // later does NOT mutate this — past buyers see what they paid for.
  digitalFulfillment    String?   @db.Text
  digitalFulfilledAt    DateTime?

  // V2.1 Drop-off + AI Tracking flow. Replaces EasyParcel for the default
  // shipping path. Seller flow:
  //   1. PAID → click "พิมพ์ใบปะหน้า" → server stamps `labelGeneratedAt`,
  //      returns printable HTML (address + QR linking to /o/<token>).
  //   2. Seller takes parcel + label to any courier, pays cash.
  //   3. Courier prints receipt with tracking#. Seller snaps photo →
  //      uploads → Claude vision OCR extracts {trackingNumber, receiverName,
  //      courier}. Match by receiverName → auto-fills `trackingNumber`
  //      + flips PAID→SHIPPING + emails buyer + LINE push.
  // `shippingReceiptUrl` = Vercel Blob URL of the uploaded receipt photo
  // (kept for dispute audit). `shippingReceiptScannedAt` = when OCR
  // completed successfully. 911korn 2026-05-27 idea — "ให้ ai scan แล้ว
  // เอาไปยัดให้กับสินค้านั้นๆ ก็จบแล้ว".
  labelGeneratedAt         DateTime?
  shippingReceiptUrl       String?
  shippingReceiptScannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, createdAt])
  @@index([shopId, customerLineUserId, createdAt])
  @@index([customerLineUserId, createdAt])
  @@index([createdAt])
}

enum OrderCancelledBy {
  BUYER
  SELLER
  SYSTEM
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // "manual" now; future values can be "easyparcel", "shippop", etc.
  provider           String  @default("manual")
  providerShipmentId String?

  courierCode String
  courierName String
  serviceName String?
  // "PICKUP" or "DROPOFF" kept as string to allow provider-specific modes later.
  handoff     String  @default("DROPOFF")
  // "DRAFT" | "READY_TO_SHIP" | "IN_TRANSIT" | "DELIVERED" | "CANCELLED"
  status      String  @default("READY_TO_SHIP")

  trackingNumber String?
  labelUrl       String?

  senderName     String?
  senderPhone    String?
  senderAddress  String?
  senderPostcode String?

  receiverName     String
  receiverPhone    String?
  receiverAddress  String?
  receiverPostcode String?

  parcelWeightGram Int?
  parcelWidthCm    Int?
  parcelLengthCm   Int?
  parcelHeightCm   Int?

  shippingFeeSatang Int?
  codAmountSatang   Int?
  note              String?

  bookedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId, status, createdAt])
  @@index([trackingNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shop Stories (V2) — 24-hour ephemeral content
// ─────────────────────────────────────────────────────────────────────────────

/// Ephemeral 24h shop posts (Instagram-style stories). Used to surface
/// promotions, new arrivals, and behind-the-scenes content without
/// polluting the permanent product catalog.
///
/// We don't store views as a per-user table (would explode for popular
/// shops) — `viewCount` is a simple counter, optionally augmented by a
/// V2.1 sampled analytics table if we ever need cohorts.
model ShopStory {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Asset URL — Vercel Blob. Either an image (jpeg/png/webp) or a short
  // video (mp4, ≤ 30s, ≤ 20MB). Mobile uploader enforces the limits.
  mediaUrl  String
  mediaKind ShopStoryMediaKind @default(IMAGE)

  // Optional caption rendered at the bottom of the story.
  caption String? @db.Text

  // Optional deep link target (product slug or external URL). Tapping the
  // story opens this link inside the app.
  linkProductSlug String?
  linkUrl         String?

  // Lifetime: stories surface in the feed for 24h, then auto-hide. The cron
  // that recomputes trust also nukes expired stories every hour.
  expiresAt DateTime

  viewCount Int @default(0)
  createdAt DateTime @default(now())

  @@index([shopId, expiresAt])
  @@index([expiresAt])
}

enum ShopStoryMediaKind {
  IMAGE
  VIDEO
}

// ─────────────────────────────────────────────────────────────────────────────
// Live Shopping (V2.0)
// ─────────────────────────────────────────────────────────────────────────────

/// A live broadcast stream owned by a shop. Provider-agnostic — we store an
/// opaque `rtcChannelId` and `rtcToken` (or playback URL) so the actual
/// streaming stack can be swapped (Agora / 100ms / LiveKit / Cloudflare
/// Realtime / etc.) without schema changes.
///
/// Lifecycle:
///   SCHEDULED → LIVE → ENDED (terminal)
///
/// During LIVE: viewerCount is bumped via `/live/:id/heartbeat`, comments
/// stream via `LiveComment`, and `pinnedProductSlug` highlights one product
/// at a time (seller can rotate).
model LiveBroadcast {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  // Pre-go-live cover image — shown on the discovery feed before SCHEDULED
  // streams go live, and used as a fallback poster on the watch screen.
  coverImageUrl String?

  // Provider-agnostic RTC handles. `rtcChannelId` is whatever the provider
  // uses to identify the broadcast room. `rtcPublishToken` is the seller's
  // (write) token; `rtcSubscribeToken` is the public (read) token. For
  // HTTP-based providers (HLS), `playbackUrl` carries the .m3u8 URL.
  rtcProvider       String? // "agora" | "100ms" | "livekit" | "cloudflare"
  rtcChannelId      String?
  rtcPublishToken   String?
  rtcSubscribeToken String?
  playbackUrl       String?
  replayUrl         String? // Set when ENDED + transcode completes

  status      LiveBroadcastStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // Featured product slot. The seller can pin different products throughout
  // the live to drive in-stream conversion. We just store a slug so we can
  // resolve to the current product at render time (price/stock fresh).
  pinnedProductSlug String?

  // Approximate live viewer count, bumped via heartbeats. NOT precise — the
  // V2.1 sampled analytics table will compute true unique-viewers.
  viewerCount Int @default(0)
  // Cumulative views across the lifetime of the broadcast (incremented on
  // each new viewer connect; never decremented).
  totalViews Int @default(0)

  comments LiveComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, scheduledAt])
  @@index([status, startedAt])
}

enum LiveBroadcastStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// One comment posted by a viewer during a LiveBroadcast. Public, attribution
/// optional — anonymous viewers can comment with just a display name. We
/// rely on a soft moderation queue (V2.1) for abuse handling; for now,
/// sellers can manually delete any comment via the broadcast control panel.
model LiveComment {
  id          String @id @default(cuid())
  broadcastId String
  broadcast   LiveBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // Anonymous-friendly. If the user is logged in we capture the userId for
  // moderation; otherwise we just keep the display name.
  userId      String?
  displayName String
  body        String  @db.Text

  // Special "system" comments (e.g. "📦 ลูกค้าสั่งสินค้า X") are flagged so
  // the UI can render them differently. Default false = normal user comment.
  isSystem Boolean @default(false)

  // Soft delete by seller (or auto-mod). Hidden from public list but kept
  // in DB for audit.
  deleted Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([broadcastId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Disputes (V1.5 Trust Layer)
// ─────────────────────────────────────────────────────────────────────────────

/// Buyer-initiated dispute on an Order. Opens within 7 days of DELIVERED;
/// admin can auto-resolve in favor of buyer if shop misses the 72h response
/// window. Evidence is a Json array of {kind: "image"|"text", value: string}.
model Dispute {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Buyer who opened the dispute (denormalized so we still know who when
  // the order's customerLineUserId field changes due to LINE re-link).
  openedByUserId  String?
  openedByName    String
  openedByPhone   String?
  openedByLineId  String?

  reason     DisputeReason
  // Free text description from the buyer. Capped to keep DB clean.
  description String        @db.Text
  // [{ kind: "image" | "text", value: string }, ...] — images are Vercel Blob URLs.
  evidence    Json          @default("[]")

  status     DisputeStatus @default(OPEN)
  resolution String?       @db.Text
  // Set when admin (or auto-resolver) closes the dispute.
  resolvedByUserId String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

enum DisputeReason {
  NOT_RECEIVED          // ของไม่มาส่ง
  WRONG_ITEM            // ของผิด
  DAMAGED               // ของเสียหาย
  NOT_AS_DESCRIBED      // ของไม่ตรงปก
  PAYMENT_ISSUE         // ปัญหาการชำระเงิน
  OTHER
}

enum DisputeStatus {
  OPEN
  AWAITING_SHOP_RESPONSE
  AWAITING_BUYER_RESPONSE
  RESOLVED_REFUND
  RESOLVED_REPLACE
  RESOLVED_NO_ACTION
  CLOSED
}

// ─────────────────────────────────────────────────────────────────────────────
// Affiliate Payouts (V1.6.1)
// ─────────────────────────────────────────────────────────────────────────────

/// User-initiated request to cash out accumulated affiliate commissions.
///
/// Flow:
///   1. User taps "ขอรับเงิน" in /me/earnings → POST /api/v1/me/payouts with
///      desired PromptPay account.
///   2. Row inserted with REQUESTED status.
///   3. Admin reviews in /admin/payouts → APPROVED or REJECTED.
///   4. Admin manually transfers via PromptPay → marks PAID with `providerRef`.
///
/// `amountSatang` is locked at request time. We recompute the user's
/// available balance from delivered orders ON request — payouts that get
/// rejected free the locked amount automatically because the running
/// balance derivation is based on `Order.status === DELIVERED MINUS sum
/// of payouts in (REQUESTED, APPROVED, PAID)`.
model AffiliatePayout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Locked-in commission amount at request time (in satang).
  amountSatang Int

  // PromptPay destination — phone or NID. Whatever the user wants the
  // money sent to. We don't validate format strictly; admin handles.
  promptpayId String

  status AffiliatePayoutStatus @default(REQUESTED)

  // Set when admin transfers money; opaque ref like "txn-2026-05-26-001".
  // Surfaced to the user in their payouts history.
  providerRef String?

  // Admin's reason for rejection (so the user understands why).
  rejectedReason String? @db.Text

  // Audit trail.
  reviewedByUserId String?
  reviewedAt       DateTime?
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum AffiliatePayoutStatus {
  REQUESTED // User submitted, awaiting admin
  APPROVED  // Admin approved, awaiting bank transfer
  PAID      // Money sent
  REJECTED  // Admin rejected (with reason)
  CANCELLED // User withdrew before review
}

// Anonymous checkout address memory. Scoped by shop + normalized phone so repeat
// customers can reuse shipping addresses without an account.
model CustomerAddress {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String?
  label         String?
  address       String   @db.Text
  addressKey    String
  postcode      String?
  useCount      Int      @default(1)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, customerPhone, addressKey])
  @@index([shopId, customerPhone, lastUsedAt])
}

