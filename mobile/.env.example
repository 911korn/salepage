# SalePage Mobile env (used by app.config.ts -> Constants.expoConfig.extra)
# Copy to .env.local for local dev. Production values are baked into EAS build
# profiles in eas.json so you don't need .env in CI.

# API base. Use http://<LAN-IP>:3000 when running web on simulator/device.
EXPO_PUBLIC_API_BASE_URL=https://salepage.in.th

# Platform-level LINE LIFF (single LIFF for all SalePage shops, see web app)
EXPO_PUBLIC_LINE_LIFF_ID=
EXPO_PUBLIC_LINE_LOGIN_CHANNEL_ID=

# EAS / Expo project linkage (set after `eas init`)
EAS_PROJECT_ID=
