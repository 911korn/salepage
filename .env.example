# SalePage env (api-first stack for salepage.in.th)
# Copy to .env.local for dev, or set in Vercel project settings for prod.

# ---- Slip verification provider ----
# Options: "slipok" | "easyslip" | "mock" (default if unset = "mock")
SLIP_VERIFY_PROVIDER=mock

# Required if SLIP_VERIFY_PROVIDER=slipok
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ---- LINE @salepage customer identity ----
# Single platform LIFF/OA used by buyers to track orders across shops.
# Put the LIFF endpoint URL as https://salepage.in.th in LINE Developers.
NEXT_PUBLIC_LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
SALEPAGE_LINE_CHANNEL_SECRET=
SALEPAGE_LINE_CHANNEL_ACCESS_TOKEN=

# ---- Auth (TODO when /signup ships) ----
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Database (TODO when Prisma lands) ----
# DATABASE_URL=postgres://...


# ---- Claude vision OCR for shipping receipts ----
ANTHROPIC_API_KEY=
