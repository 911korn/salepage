# SalePage env (api-first stack for salepage.in.th)
# Copy to .env.local for dev, or set in Vercel project settings for prod.

# ---- Slip verification provider ----
# Options: "slipok" | "easyslip" | "mock" (default if unset = "mock")
SLIP_VERIFY_PROVIDER=mock

# Required if SLIP_VERIFY_PROVIDER=slipok
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ---- Auth (TODO when /signup ships) ----
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Database (TODO when Prisma lands) ----
# DATABASE_URL=postgres://...
